aws_region = "us-east-1"

# Lock SSH to your IP + the AAP controller's public IP
allowed_ssh_cidrs = ["203.0.113.0/32"]

# Route53 hosted zone — managed node becomes rhel-drift.<domain>
demo_domain           = "sandbox2797.opentlc.com"
managed_node_hostname = "rhel-drift"

# Leave empty to use default VPC/subnet
# vpc_id    = "vpc-0123456789abcdef0"
# subnet_id = "subnet-0123456789abcdef0"
