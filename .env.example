# =============================================================================
# Config Drift Remediation Demo — Environment Variables
# =============================================================================
# Copy to .env and fill in real values. .env is gitignored.
# Used by: ansible_deployment/scripts/cac-apply.sh
#          ansible_deployment/cac/apply.yml (via lookup('env', ...))
# =============================================================================

# -- AAP Controller ----------------------------------------------------------
AAP_BASE_URL=https://aap.example.com/api/controller/v2/
AAP_API_CLIENT_BEARER_TOKEN=your-aap-oauth-token
AAP_VALIDATE_CERTS=false
ORG_ADMIN_PASSWORD=changeme

# -- Git repos ----------------------------------------------------------------
# Both projects can point to the same repo (config-baseline is a subdirectory).
CONFIG_BASELINE_REPO_URL=https://github.com/crenwick93/config-drift-eda.git
CONFIG_BASELINE_BRANCH=main
CONFIG_DRIFT_EDA_REPO_URL=https://github.com/crenwick93/config-drift-eda.git
CONFIG_DRIFT_EDA_BRANCH=main

# -- Managed node SSH ---------------------------------------------------------
MANAGED_NODE_SSH_USER=ec2-user
MANAGED_NODE_SSH_KEY=~/.ssh/config-drift-key.pem

# -- Splunk HEC (close-the-loop reporting) ------------------------------------
SPLUNK_HEC_URL=https://input-prd-p-XXXXXXX.splunkcloud.com:8088/services/collector/event
SPLUNK_HEC_TOKEN=your-hec-token-here

# -- ServiceNow PDI (incident audit trail) ------------------------------------
SERVICENOW_INSTANCE_URL=https://devXXXXXX.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=your-password-here
SERVICENOW_CALLER_NAME=Ansible Automation

# -- EDA Event Stream (Splunk webhook auth token) ----------------------------
# Splunk sends this token in the Authorization header when firing webhooks.
# Must match the Token credential on the EDA Event Stream.
SPLUNK_WEBHOOK_TOKEN=changeme

# -- EDA Decision Environment image ------------------------------------------
# Default: stock AAP 2.6 DE (webhook source is built in). No custom build needed.
WEBHOOK_DE_IMAGE=registry.redhat.io/ansible-automation-platform-26/de-minimal-rhel9:latest

# -- Managed node hosts (JSON array for Controller inventory) -----------------
# Override if you want cac-apply.sh to populate hosts automatically.
# MANAGED_NODE_HOSTS=[{"name":"rhel-managed-1","inventory":"RHEL Managed Nodes","variables":{"ansible_host":"10.0.1.10"}}]

# -- DNS (Route53) ------------------------------------------------------------
# Base domain with an existing hosted zone. Managed node becomes rhel-drift.<domain>.
DEMO_DOMAIN=sandbox2797.opentlc.com

# -- AWS (Terraform reads credentials from ~/.aws/credentials) ----------------
AWS_REGION=eu-west-1
