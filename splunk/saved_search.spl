| -- Splunk saved search: Config Drift Detected
| -- Configure as: Scheduled alert, cron * * * * *, time range -1m@m to now
| -- Alert action: Webhook → https://<aap-host>/api/eda/v1/external_event_stream/<uuid>/post/
| -- Trigger: For each result (Number of Results > 0)
| -- Prerequisite: Add AAP EDA host to Splunk Cloud webhook allow-list
| --   (Settings → Server Settings → Webhook allow list)

index=main sourcetype=linux:audit type=SYSCALL key=config_drift
| dedup host
| rename key as drift_key
| table _time, host, auid, drift_key, name
